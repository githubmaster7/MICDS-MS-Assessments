DATABASE_URL="postgresql://user:password@localhost:5432/micds_pe"
# Prisma connection pool sizing (optional — sane defaults applied if unset).
# See the comment above buildPooledDatabaseUrl() in src/lib/db.ts before changing.
DATABASE_CONNECTION_LIMIT="10"
DATABASE_POOL_TIMEOUT="20"
NEXTAUTH_SECRET="your-secret-here-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"
# The allowed signup email domain ("micds.org") is not read from an env var -
# it's hardcoded in src/lib/constants.ts. Change it there, not here.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
# "true" for a TLS connection on port 465, "false" for STARTTLS on 587 (the
# default above) - see src/lib/email.ts.
SMTP_SECURE="false"
SMTP_USER="noreply@micds.org"
SMTP_PASS="your-smtp-password"
SMTP_FROM="MICDS PE <noreply@micds.org>"
NODE_ENV="development"
